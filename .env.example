# Application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# Auth (server-only unless prefixed NEXT_PUBLIC_)
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_URL="http://localhost:3000"
AUTH_THROTTLE_SECRET="replace-with-a-separate-random-secret"
AUTH_TRUST_HOST="true"
# Enable only behind a trusted reverse proxy that replaces forwarded IP headers.
AUTH_TRUST_PROXY_HEADERS="false"
# Railway replaces X-Real-IP. Change this only for a reviewed proxy/CDN topology.
AUTH_CLIENT_IP_HEADER="x-real-ip"
AUTH_ALLOWED_ORIGINS=""
AUTH_GOOGLE_ENABLED="false"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_EMAIL_FROM="Haus of Estate <noreply@hausofestate.com>"

# Product features. Keep disabled until their respective launch gates are met.
SAVED_CONTENT_ENABLED="false"
PROPERTY_ASSISTANT_ENABLED="false"
AI_GATEWAY_API_KEY=""
PROPERTY_ASSISTANT_MODEL="openai/gpt-5.6-luna"
PROPERTY_ASSISTANT_USAGE_SECRET="replace-with-a-separate-random-secret"
PROPERTY_ASSISTANT_DAILY_TOKEN_BUDGET="500000"
# Exact HTTPS citation hosts used by assistant-approved Sanity guidance.
PROPERTY_ASSISTANT_SOURCE_HOSTS="hausofestate.com,www.hausofestate.com"

# Exact pending-migration set. Leave empty until backup/schema checks and approval.
HAUS_DATABASE_MIGRATIONS_APPROVED=""

# Content
NEXT_PUBLIC_SANITY_PROJECT_ID="jdxbkry4"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_STUDIO_DATASET="staging"
SANITY_API_READ_TOKEN=""
SANITY_API_BROWSER_TOKEN=""
SANITY_REVALIDATE_SECRET=""
NEXT_PUBLIC_SANITY_SOCIAL_CAMPAIGNS_ENABLED="false"
SANITY_WRITE_TOKEN=""

# Email
RESEND_API_KEY=""
ADMIN_EMAIL="info@hausofestate.com"
CAREERS_EMAIL="info@hausofestate.com"

# Analytics
NEXT_PUBLIC_GTM_ID=""

# Phase-one lead intake. Both flags are disabled by default.
LEAD_INTAKE_ENABLED="false"
LEAD_DELIVERY_ENABLED="false"
LEAD_ALLOWED_ORIGINS="http://localhost:3000"
LEAD_RATE_LIMIT_SECRET="replace-with-a-long-random-value"

# Educational purchase-readiness guide. This never enables payment collection.
PURCHASE_READINESS_ENABLED="false"

# Power Automate delivery. Keep every value server-only.
POWER_AUTOMATE_FLOW_URL=""
POWER_AUTOMATE_TENANT_ID=""
POWER_AUTOMATE_CLIENT_ID=""
POWER_AUTOMATE_CLIENT_SECRET=""
POWER_AUTOMATE_SCOPE="https://service.flow.microsoft.com//.default"

# Optional worker tuning. Railway runs the one-shot worker every five minutes.
LEAD_DELIVERY_BATCH_SIZE="20"
LEAD_DELIVERY_MAX_ATTEMPTS="8"
LEAD_DELIVERY_LEASE_SECONDS="600"
LEAD_DELIVERY_BASE_DELAY_SECONDS="300"
LEAD_DELIVERY_MAX_DELAY_SECONDS="21600"
LEAD_DELIVERY_TIMEOUT_MS="8000"
