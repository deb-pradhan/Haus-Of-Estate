# Application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email
RESEND_API_KEY=""
ADMIN_EMAIL="info@hausofestate.com"
CAREERS_EMAIL="info@hausofestate.com"

# Analytics
NEXT_PUBLIC_GTM_ID=""

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="jdxbkry4"
# Local/public preview site content. Production deployments must set this to
# "production" explicitly after approval.
NEXT_PUBLIC_SANITY_DATASET="staging"
# Embedded Studio and Sanity CLI target. Keep staging locally; set production
# only in an approved production deployment.
SANITY_STUDIO_DATASET="staging"
# Viewer-only server token for authenticated draft queries.
SANITY_API_READ_TOKEN=""
# Separate Viewer-only token that next-sanity exposes to an authenticated draft
# preview browser for live updates. Never give it mutation permissions.
SANITY_API_BROWSER_TOKEN=""
# Long random secret configured on the signed Sanity webhook.
SANITY_REVALIDATE_SECRET=""
NEXT_PUBLIC_SANITY_SOCIAL_CAMPAIGNS_ENABLED="false"

# One-off maintenance scripts only. Never expose this value to the browser.
SANITY_WRITE_TOKEN=""
