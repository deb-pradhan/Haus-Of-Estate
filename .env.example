# ─── Sanity CMS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=jdxbkry4
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=

# ─── Pexels API (placeholder image sourcing) ─────────────────────────────────────
PEXELS_API_KEY=

# ─── Database (Railway PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL="https://hausofestate.com/"
AUTH_URL_LOCAL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=info@hausofestate.com

# ─── Analytics & marketing (audit task #25–28) ────────────────────────────────
# Until each of these is set the corresponding script does not load.
# Format examples shown below.
NEXT_PUBLIC_GA4_ID=G-FEZF22MELJ
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_HUBSPOT_ID=
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID=
NEXT_PUBLIC_CALENDLY_URL=

# ─── GA4 Measurement Protocol (server-side, optional) ─────────────────────────
# Same Measurement ID as `NEXT_PUBLIC_GA4_ID`. The `api_secret` is generated in
# GA4 → Admin → Data Streams → [web stream] → Measurement Protocol API secrets.
# Until both are set, server-side `trackServerEvent()` calls no-op with a warn.
GA4_MEASUREMENT_ID=G-FEZF22MELJ
GA4_API_SECRET=

# ─── Verification files (audit task #24) ──────────────────────────────────────
# See SETUP.md for the full Google Search Console / Bing / Cloudflare setup.
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=
# ─── Security / rate limiting ─────────────────────────────────────────────────
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (Railway = 1; Cloudflare in front of Railway = 2; 0 = ignore forwarding headers).
TRUSTED_PROXY_COUNT=1
# SANITY_REVALIDATE_SECRET must be at least 16 characters or /api/revalidate/path refuses to run.
