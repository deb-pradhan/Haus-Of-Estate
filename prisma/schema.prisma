generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  AGENT
  ADMIN
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  LAND
}

enum ListingType {
  SALE
  RENT
  OFF_PLAN
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  SOLD
  RENTED
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  OPEN
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReviewType {
  POST_VIEWING
  POST_DEAL
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  phone          String?
  avatar         String?
  role           UserRole  @default(BUYER)
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  savedListings  String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  agentProfile    AgentProfile?
  sentMessages    Message[]       @relation("SentMessages")
  buyerThreads    MessageThread[] @relation("BuyerThreads")
  viewingRequests ViewingRequest[] @relation("BuyerViewings")
  buyerOffers     Offer[]         @relation("BuyerOffers")
  writtenReviews  Review[]        @relation("WrittenReviews")
  notifications   Notification[]
  leads           Lead[]

  @@index([email])
  @@index([role])
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency          String
  bio             String   @default("")
  languages       String[] @default([])
  specializations String[] @default([])
  responseTime    String   @default("< 1 hr")
  dealsCompleted  Int      @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)

  listings        Property[]
  agentThreads    MessageThread[] @relation("AgentThreads")
  agentViewings   ViewingRequest[] @relation("AgentViewings")
  agentOffers     Offer[]          @relation("AgentOffers")
  receivedReviews Review[]         @relation("AgentReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  description  String
  price        Float
  currency     String         @default("AED")
  propertyType PropertyType
  listingType  ListingType
  bedrooms     Int
  bathrooms    Int
  area         Float
  areaUnit     String         @default("sqft")
  status       PropertyStatus @default(DRAFT)
  verified     Boolean        @default(false)
  featured     Boolean        @default(false)

  locationArea     String
  locationCity     String   @default("Dubai")
  locationBuilding String?
  locationLat      Float?
  locationLng      Float?

  videoUrl   String?
  images     String[] @default([])
  thumbnail  String?

  features String[] @default([])

  agentId String
  agent   AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  messageThreads  MessageThread[]
  viewingRequests ViewingRequest[]
  offers          Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([agentId])
  @@index([propertyType])
  @@index([listingType])
  @@index([locationArea])
  @@index([price])
}

model MessageThread {
  id         String @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User   @relation("BuyerThreads", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId    String
  agent      AgentProfile @relation("AgentThreads", fields: [agentId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, buyerId, agentId])
  @@index([buyerId])
  @@index([agentId])
}

model Message {
  id       String @id @default(cuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content  String
  read     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
}

model ViewingRequest {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User          @relation("BuyerViewings", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId    String
  agent      AgentProfile  @relation("AgentViewings", fields: [agentId], references: [id], onDelete: Cascade)

  preferredSlots String[]
  confirmedSlot  DateTime?
  status         ViewingStatus @default(REQUESTED)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([buyerId])
  @@index([agentId])
  @@index([status])
}

model Offer {
  id         String      @id @default(cuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User        @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId    String
  agent      AgentProfile @relation("AgentOffers", fields: [agentId], references: [id], onDelete: Cascade)

  amount   Float
  currency String      @default("AED")
  terms    String?
  status   OfferStatus @default(OPEN)

  events OfferEvent[]

  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([buyerId])
  @@index([agentId])
  @@index([status])
}

model OfferEvent {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  type    String
  amount  Float?
  terms   String?
  by      String

  createdAt DateTime @default(now())

  @@index([offerId])
}

model Review {
  id         String     @id @default(cuid())
  agentId    String
  agent      AgentProfile @relation("AgentReviews", fields: [agentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User       @relation("WrittenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  rating Int
  text   String
  type   ReviewType

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([reviewerId])
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  body    String
  link    String?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Lead {
  id                   String                   @id @default(cuid())
  submissionId         String?                  @unique
  payloadHash          String?
  email                String
  firstName            String
  surname              String?
  phone                String?
  intent               String
  market               String?
  buyOrRent            String?
  useType              String?
  bedrooms             String?
  bathrooms            String?
  area                 String?
  sellOrRent           String?
  propertyType         String?
  location             String?
  size                 String?
  viewType             String?
  urgency              String?
  budget               String?
  timeline             String?
  message              String?                  @db.Text
  projectSlug          String?
  projectTitle         String?
  projectCommunity     String?
  score                Int                      @default(0)
  tier                 String?
  routing              String?
  consentGiven         Boolean                  @default(false)
  newsletterOptIn      Boolean                  @default(false)
  formVersion          String?
  privacyNoticeVersion String?
  formSurface          String?
  pagePath             String?
  referrer             String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  source               String?
  userId               String?
  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifiedAt           DateTime?
  consentEvents        NewsletterConsentEvent[]
  deliveryOutbox       LeadDeliveryOutbox?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([email])
  @@index([tier])
  @@index([routing])
  @@index([projectSlug])
  @@index([newsletterOptIn])
  @@index([createdAt])
}

enum NewsletterSubscriptionStatus {
  ACTIVE
  WITHDRAWN
}

enum NewsletterConsentEventType {
  OPT_IN
  WITHDRAWAL
}

model NewsletterSubscription {
  id          String                       @id @default(cuid())
  email       String                       @unique
  status      NewsletterSubscriptionStatus @default(ACTIVE)
  consentedAt DateTime?
  withdrawnAt DateTime?
  events      NewsletterConsentEvent[]
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([status])
  @@index([updatedAt])
}

model NewsletterConsentEvent {
  id                   String                     @id @default(cuid())
  subscriptionId       String
  subscription         NewsletterSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  leadId               String?
  lead                 Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type                 NewsletterConsentEventType
  wording              String                     @db.Text
  privacyNoticeVersion String
  formVersion          String
  pageContext          String
  source               String?
  campaign             String?
  createdAt            DateTime                   @default(now())

  @@index([subscriptionId, createdAt])
  @@index([leadId])
  @@index([type, createdAt])
}

model LeadDeliveryOutbox {
  id          String    @id @default(cuid())
  leadId      String    @unique
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  deliveredAt DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
}

model LeadSubmissionThrottle {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
