import { defineConfig, type Template } from 'sanity'
import { presentationTool } from 'sanity/presentation'
import { structureTool } from 'sanity/structure'
import { visionTool } from '@sanity/vision'

// Release 2 owns this shared source. Never copy schemas into the Studio.
import { schemaTypes } from '__APP_RELATIVE_PATH__/src/sanity/schemaTypes'
import { presentationResolve } from '__APP_RELATIVE_PATH__/src/sanity/presentation'
import { createStudioStructure } from '__APP_RELATIVE_PATH__/src/sanity/structure'
import { guardEditorialPublishAction } from '__APP_RELATIVE_PATH__/src/sanity/workflow-actions'

const previewOrigin = process.env.SANITY_STUDIO_PREVIEW_ORIGIN || 'http://localhost:3000'
const socialCampaignsEnabled = process.env.SANITY_STUDIO_SOCIAL_CAMPAIGNS_ENABLED === 'true'
const guardedEditorialTypes = new Set(['post', 'property'])

export default defineConfig({
  name: 'haus-of-estate-studio',
  title: 'Haus Of Estate — Production',
  basePath: '/',
  projectId: 'jdxbkry4',
  dataset: 'production',
  plugins: [
    structureTool({ structure: createStudioStructure({ socialCampaignsEnabled }) }),
    presentationTool({
      resolve: presentationResolve,
      previewUrl: {
        initial: previewOrigin,
        previewMode: { enable: '/api/draft-mode/enable', shareAccess: false },
      },
      allowOrigins: [previewOrigin],
    }),
    visionTool(),
  ],
  schema: { types: schemaTypes },
  templates: (templates: Template[]) => socialCampaignsEnabled
    ? templates
    : templates.filter(({ schemaType }) => schemaType !== 'socialCampaign'),
  document: {
    newDocumentOptions: (options) => socialCampaignsEnabled
      ? options
      : options.filter(({ templateId }) => templateId !== 'socialCampaign'),
    actions: (actions, context) => guardedEditorialTypes.has(context.schemaType)
      ? actions.map((action) => action.action === 'publish' ? guardEditorialPublishAction(action) : action)
      : actions,
  },
})
